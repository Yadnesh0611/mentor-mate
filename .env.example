# =============================================================================
# MENTOR MATE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in your deployment and fill in genuine credentials.
# NEVER commit real API keys, tokens, or passwords to source control.
# =============================================================================

# --- BACKEND CONFIGURATION ---
# FastAPI Application Secret Key (Generate a random 64-char hex key)
SECRET_KEY=your-super-secret-random-jwt-key-here

# Database URL: Supports SQLite (aiosqlite) or PostgreSQL (asyncpg)
# Example SQLite: sqlite+aiosqlite:///./mentormate.db
# Example Postgres: postgresql+asyncpg://user:password@localhost:5432/mentormate
DATABASE_URL=sqlite+aiosqlite:///./mentormate.db

# OmniRoute AI Gateway Configuration (Default: port 20128)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_DEFAULT_MODEL=auto/fast
OMNIROUTE_REASONING_MODEL=auto/chat
OMNIROUTE_VISION_MODEL=auto/best-vision

# OpenClaw Autonomous Agent Gateway Configuration (Default: port 18789)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=your_openclaw_gateway_token_here

# Optional Direct Cloud Provider Fallback (used only if OmniRoute is unconfigured)
OPENAI_API_KEY=

# --- FRONTEND CONFIGURATION ---
# Next.js API Base URL pointing to FastAPI backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
